# Raw bot token from the Discord Developer Portal (without a "Bot " prefix).
# Leave unset for Twitch-only operation.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional hosted Twitch support, alongside Discord or by itself.
# Broadcasters /mod the bot in their channel, then !join in the bot account's chat.
# Channel registrations live in PostgreSQL; !leave in the bot's chat removes them.
# User token scopes: user:read:chat user:write:chat
# moderator:manage:banned_users moderator:manage:chat_messages user:read:moderated_channels
# TWITCH_CLIENT_ID=replace-with-your-twitch-application-client-id
# TWITCH_CLIENT_SECRET=replace-with-your-twitch-application-client-secret
# TWITCH_BOT_LOGIN=your_bot_account
# PUBLIC_URL=https://jeeves.example.com
# Register PUBLIC_URL/auth/twitch/callback in the Twitch developer console.
# Visit PUBLIC_URL/auth/twitch once as the bot. Tokens are stored and refreshed in PostgreSQL.
# Alternative for manual local setup: omit CLIENT_SECRET, BOT_LOGIN and PUBLIC_URL,
# and set TWITCH_ACCESS_TOKEN to a raw user access token; manual tokens are not refreshed.

# Enable Message Content Intent in the Discord Developer Portal.
# Gemini is required for rule creation on both Discord and Twitch.
# Vertex AI uses Google Cloud billing and Application Default Credentials.
# Run: gcloud auth application-default login
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=replace-with-your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
# Alternatively: GEMINI_BACKEND=developer and set GEMINI_API_KEY for the Gemini Developer API.
# GEMINI_API_KEY=replace-with-your-gemini-api-key

# Jev client shared by message action handlers. The model override is optional.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
# TYPESAFE_MODEL=jev-latest

# Local development. For a hosted database use sslmode=verify-full (the default).
DATABASE_URL=postgres://jeeves:jeeves@localhost:5432/jeeves?sslmode=disable
# A private CA can be supplied in the URL: &sslrootcert=certs/postgres-ca.pem
DATABASE_MAX_CONNECTIONS=5

RUST_LOG=info,jeeves=debug
